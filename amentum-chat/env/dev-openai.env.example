# ---------------------------------------------------------------------------------
# Personal computer / test environment - OpenAI API
# Copy to backend/.env (local run) or env/app.env (Docker) and fill in your key.
# Uses exactly the same backend code path (openai SDK, Responses API, tools) as GCC High.
# ---------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key...

# OpenAI model ids for the three catalog entries (they match the defaults in config/models.json)
# MODEL_DEPLOYMENTS={"gpt-5.6-sol":"gpt-5.6-sol","gpt-5.6-terra":"gpt-5.6-terra","gpt-5.6-luna":"gpt-5.6-luna"}
DEFAULT_MODEL=gpt-5.6-terra
TITLE_MODEL=gpt-5.6-luna

# Thinking traces: Responses API reasoning summaries (auto | concise | detailed | off)
REASONING_SUMMARY=auto
RESPONSES_STORE=false
# Output-token cap per model request (0 = the model's maximum). Replies that hit it are continued
# automatically up to MAX_CONTINUATIONS times.
MAX_OUTPUT_TOKENS=0
MAX_CONTINUATIONS=3

# Code interpreter: local = Jupyter sandbox on this machine (same as production),
#                   hosted = OpenAI's hosted code_interpreter tool, off = disabled
CODE_INTERPRETER=local

# UI
DEV_USER=first.last
SHOW_USAGE_BY_DEFAULT=true
