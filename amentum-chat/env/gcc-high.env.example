# =====================================================================================
# Amentum AI - Azure Government (GCC High) production configuration
# Copy to env/app.env on the Amentum host (docker compose reads it). Never commit the filled-in copy.
# Full walkthrough: deploy/gcc-high/README.md
# =====================================================================================

# ---- Provider ------------------------------------------------------------------------
LLM_PROVIDER=azure_gcc_high
# Azure OpenAI resource in usgovvirginia / usgovarizona. Must end in .openai.azure.us
# (or .cognitiveservices.azure.us); the app refuses to start otherwise.
AZURE_OPENAI_ENDPOINT=https://<amentum-ai-resource>.openai.azure.us/
ENFORCE_GOV_ENDPOINTS=true

# v1 = https://<resource>.openai.azure.us/openai/v1/ (recommended when available in your region)
# versioned = /openai/...?api-version=<AZURE_OPENAI_API_VERSION>
AZURE_API_STYLE=v1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---- Authentication to Azure OpenAI --------------------------------------------------
# entra (recommended): Microsoft Entra ID tokens from login.microsoftonline.us,
#   scope https://cognitiveservices.azure.us/.default. Grant the identity the
#   "Cognitive Services OpenAI User" role on the Azure OpenAI resource.
AZURE_AUTH=entra
AZURE_TENANT_ID=<gcc-high-tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-id>
# Pick ONE credential type:
AZURE_CLIENT_CERTIFICATE_PATH=/certs/amentum-ai-sp.pem
# AZURE_CLIENT_SECRET=<secret>
# AZURE_USE_MANAGED_IDENTITY=true      # when hosted on an Azure Government VM / Container App
# Or API key auth (simpler, less preferred):
# AZURE_AUTH=key
# AZURE_OPENAI_API_KEY=<key>

# ---- Model deployments (catalog id -> your Azure deployment name) ---------------------
MODEL_DEPLOYMENTS={"gpt-5.6-sol":"gpt-5.6-sol","gpt-5.6-terra":"gpt-5.6-terra","gpt-5.6-luna":"gpt-5.6-luna"}
DEFAULT_MODEL=gpt-5.6-terra
TITLE_MODEL=gpt-5.6-luna
# If a deployment in your region does not support the Responses API yet, set "api": "chat"
# for that model in config/models.json (no thinking text; turns using tools run without extended thinking).

# ---- Data handling -----------------------------------------------------------------------
# store=false: nothing is retained by the Responses API; reasoning is carried as encrypted items.
RESPONSES_STORE=false
REASONING_SUMMARY=auto

# ---- Outbound network (only egress: Azure OpenAI + Entra ID) -----------------------------
# OUTBOUND_PROXY=http://proxy.amentum.internal:8080
# TLS inspection root CA (PEM). Mounted by docker-compose.gcchigh.yml from deploy/certs/ (see deploy/certs/README.md).
# OUTBOUND_CA_BUNDLE=/certs/amentum-root-ca.crt
REQUEST_TIMEOUT_S=600

# ---- Code interpreter (isolated sandbox container, no egress) ----------------------------
CODE_INTERPRETER=local
# SANDBOX_URL / SANDBOX_TOKEN are set by docker-compose.yml

# ---- Identity (behind Entra Application Proxy / Easy Auth / reverse proxy) ---------------
AUTH_MODE=header
AUTH_USER_HEADER=X-MS-CLIENT-PRINCIPAL-NAME
ADMIN_USERS=first.last@amentum.com,second.admin@amentum.com

# ---- MCP data connectors ---------------------------------------------------------------------
# Only administrators may add/edit connectors; users choose which ones to use per chat.
CONNECTORS_ADMIN_ONLY=true
# Local-command (stdio) servers execute on the app host - keep off unless vetted.
MCP_ALLOW_STDIO=false
MCP_TOOL_TIMEOUT_S=120

# ---- UI ---------------------------------------------------------------------------------------
APP_NAME=Amentum AI
APP_TAGLINE=Secure intelligence for mission-critical work
# UI_BANNER_TEXT=CUI // Controlled Unclassified Information
# UI_BANNER_COLOR=#502b85
SHOW_USAGE_BY_DEFAULT=false
MAX_UPLOAD_MB=100
CORS_ORIGINS=https://ai.amentum.internal
