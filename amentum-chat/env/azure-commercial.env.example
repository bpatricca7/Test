# ---------------------------------------------------------------------------------
# Optional: Azure OpenAI in the commercial cloud. Exercises the *identical* Microsoft
# code path used for GCC High (same client, same auth options) - only the cloud differs.
# ---------------------------------------------------------------------------------
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_API_STYLE=v1
AZURE_AUTH=key
AZURE_OPENAI_API_KEY=<key>
MODEL_DEPLOYMENTS={"gpt-5.6-sol":"gpt-5.6-sol","gpt-5.6-terra":"gpt-5.6-terra","gpt-5.6-luna":"gpt-5.6-luna"}
CODE_INTERPRETER=local
DEV_USER=first.last
