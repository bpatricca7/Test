{
  "name": "tandem",
  "productName": "Tandem",
  "version": "0.1.0",
  "description": "One cockpit for Claude Code and Codex. Drive both coding agents from a single desktop app.",
  "main": "./out/main/index.js",
  "author": "Tandem",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "TANDEM_LIVE=1 vitest run tests/live",
    "e2e": "node e2e/screenshot.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:all": "electron-vite build && electron-builder --mac --arm64 --x64",
    "license:keygen": "node scripts/license-keygen.mjs",
    "license:sign": "node scripts/license-sign.mjs",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.61.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
